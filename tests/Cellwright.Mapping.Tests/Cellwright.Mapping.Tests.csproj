<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cellwright.Mapping.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runs the assembly under the culture the build asks for; see the file for why. -->
    <Compile Include="..\TestCulture.cs" Link="TestCulture.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cellwright.Mapping\Cellwright.Mapping.csproj" />
    <!-- Analyzer: attributed types in this project get real generated mappers.
         Assembly reference: generator-driver tests instantiate the generator directly. -->
    <ProjectReference Include="..\..\src\Cellwright.Mapping.Generator\Cellwright.Mapping.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
