<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cellwright.Pdf.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runs the assembly under the culture the build asks for; see the file for why. -->
    <Compile Include="..\TestCulture.cs" Link="TestCulture.cs" />
    <Compile Include="..\CorpusRoot.cs" Link="CorpusRoot.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cellwright\Cellwright.csproj" />
    <ProjectReference Include="..\..\src\Cellwright.Pdf\Cellwright.Pdf.csproj" />
    <PackageReference Include="Inkwright.Layout" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" PrivateAssets="all" />
  </ItemGroup>

</Project>
