<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks and interop fixtures">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="ClosedXML" Version="0.105.0" />
    <PackageVersion Include="EPPlus" Version="8.6.3" />
  </ItemGroup>

  <ItemGroup Label="Source generator">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>

  <ItemGroup Label="Formula engine">
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="PDF output">
    <!-- Exact NuGet ranges: bare 0.1.3 means the open-ended range [0.1.3, ). -->
    <PackageVersion Include="Inkwright" Version="[0.1.4]" />
    <PackageVersion Include="Inkwright.Layout" Version="[0.1.3]" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Legacy xls">
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageVersion Include="ExcelDataReader" Version="3.7.0" />
    <!-- 2.7.6 is the last Apache-2.0 release before the binary-distribution EULA changed. -->
    <PackageVersion Include="NPOI" Version="2.7.6" />
  </ItemGroup>

</Project>
